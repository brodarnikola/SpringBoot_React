# Copy this file to ".env" and fill in real values. The .env file is git-ignored.
# Loaded automatically at startup by the spring-dotenv dependency, so that
# placeholders like ${MAIL_USERNAME} / ${MAIL_PASSWORD} in application.properties resolve.

# Gmail account used to send confirmation / password-reset emails.
MAIL_USERNAME=your-email@gmail.com

# Gmail App Password (NOT your normal password). Requires 2-Step Verification.
# Generate one at: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your-16-char-app-password
